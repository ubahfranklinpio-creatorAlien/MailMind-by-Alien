# VITE_GEMINI_API_KEY: Required for Gemini AI API calls.
# Note: When deploying to Vercel, ensure this is set as VITE_GEMINI_API_KEY
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Email Configuration (Required for IMAP fetching)
# Provide your IMAP credentials here. For Gmail or Yahoo, you may need an App Password.
EMAIL_USER=""
EMAIL_PASSWORD=""
IMAP_HOST="imap.gmail.com" # e.g., imap.gmail.com or imap.mail.yahoo.com
IMAP_PORT="993"
